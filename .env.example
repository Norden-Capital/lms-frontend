# Copy this file to `.env.local` and fill in the real values.

# Address of the backend API, reachable from the machine running Next.js.
# Server-side only — never prefix with NEXT_PUBLIC_.
BACKEND_URL=http://<host>:<port>

# Shared with the backend (its PROXY_SECRET). Lets this server pass on each
# visitor's real address, so the backend's rate limits and action log see real
# people instead of this server. Any long random string; the same on both sides.
PROXY_SECRET=
